{
  "name": "lccast-node",
  "version": "1.0.0",
  "private": true,
  "description": "LCC Cast backend (Node.js + TypeScript) - login migration from Spring Boot",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/scripts/dbCheck.ts",
    "lt:seed": "tsx src/scripts/loadtest/seed.ts",
    "lt:run": "tsx src/scripts/loadtest/run.ts",
    "lt:reset": "tsx src/scripts/loadtest/reset.ts",
    "lt:cleanup": "tsx src/scripts/loadtest/cleanup.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "sockjs": "^0.3.24"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/sockjs": "^0.3.36",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "ws": "^8.22.1"
  }
}
